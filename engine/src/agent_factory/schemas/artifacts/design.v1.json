{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-factory:artifact:design:v1",
  "title": "design@1",
  "description": "Design doc, API contract and task plan: the files written, by digest.",
  "type": "object",
  "required": [
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
