{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-factory:artifact:image:v1",
  "title": "image@1",
  "description": "A built image: its reference, with the SBOM and provenance files when produced.",
  "type": "object",
  "required": [
    "ref",
    "sbom",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "sbom": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
