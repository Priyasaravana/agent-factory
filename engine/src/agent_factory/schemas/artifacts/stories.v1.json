{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-factory:artifact:stories:v1",
  "title": "stories@1",
  "description": "Stories with acceptance criteria (composable SDLC step 4).",
  "type": "object",
  "required": [
    "stories"
  ],
  "additionalProperties": false,
  "properties": {
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "acceptance"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^R[0-9]+$"
            }
          }
        }
      }
    }
  }
}
