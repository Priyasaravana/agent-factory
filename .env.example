# Copy to .env (never commit .env). See docs/adr/0005-model-access.md.

# live = real agents, docker, kind;  dry-run = simulated workflow, zero model usage
FACTORY_MODE=dry-run

# --- Model access: set ONE ---------------------------------------------------
# Subscription (run `claude setup-token` on your Mac, paste the token):
CLAUDE_CODE_OAUTH_TOKEN=
# or an API key:
ANTHROPIC_API_KEY=
# or Bedrock (also set AWS_REGION and AWS credentials):
# CLAUDE_CODE_USE_BEDROCK=1

# --- Credentials for integrations ---------------------------------------------
# The config never holds credentials; it names where they live
# (integrations.<id>.auth.secret_ref). `env://NAME` reads the variables below, which is
# fine for a laptop. For shared setups point the references at a secret manager
# instead (aws-sm://..., vault://..., file:///run/secrets/...) and leave these empty.

# --- Publishing generated products to GitHub ---------------------------------
# Fine-grained token: Administration (create repos) + Contents read/write.
GITHUB_TOKEN=
# Read-only token for importing workflow templates and skills from PRIVATE
# GitHub repos (Contents: read). Public repos need no token.
SKILLS_GITHUB_TOKEN=
GIT_AUTHOR_NAME=Ezhil Priyadharshini Krishna
GIT_AUTHOR_EMAIL=dharshini.prasad@gmail.com
