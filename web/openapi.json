{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent Factory API",
    "description": "API-first control plane for the agent software factory. Every route is a shared action also available to agents.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "factory"
        ],
        "summary": "Factory health and readiness",
        "description": "Factory health and readiness",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthView"
                }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "tags": [
          "factory"
        ],
        "summary": "The factory line, policies and product lines",
        "description": "The factory line, policies and product lines",
        "operationId": "get_config",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigView"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders": {
      "get": {
        "tags": [
          "factory"
        ],
        "summary": "List orders, newest first",
        "description": "List orders, newest first",
        "operationId": "list_orders",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  },
                  "type": "array",
                  "title": "Response List Orders"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "factory"
        ],
        "summary": "Submit requirements; starts the first run",
        "description": "Submit requirements; starts the first run",
        "operationId": "create_order",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders/{order_id}": {
      "get": {
        "tags": [
          "factory"
        ],
        "summary": "Order with its runs and feedback",
        "description": "Order with its runs and feedback",
        "operationId": "get_order",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders/{order_id}/feedback": {
      "post": {
        "tags": [
          "factory"
        ],
        "summary": "Post-deploy feedback; starts the next iteration",
        "description": "Post-deploy feedback; starts the next iteration",
        "operationId": "submit_feedback",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}": {
      "get": {
        "tags": [
          "factory"
        ],
        "summary": "Run with station states",
        "description": "Run with station states",
        "operationId": "get_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/events": {
      "get": {
        "tags": [
          "factory"
        ],
        "summary": "Append-only event/decision log for a run",
        "description": "Append-only event/decision log for a run",
        "operationId": "list_events",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Event"
                  },
                  "title": "Response List Events"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/answers": {
      "post": {
        "tags": [
          "factory"
        ],
        "summary": "Answer intake's blocking questions",
        "description": "Answer intake's blocking questions",
        "operationId": "answer_questions",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswersInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/resume": {
      "post": {
        "tags": [
          "factory"
        ],
        "summary": "Resume a held, interrupted or paused run",
        "description": "Resume a held, interrupted or paused run",
        "operationId": "resume_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/cancel": {
      "post": {
        "tags": [
          "factory"
        ],
        "summary": "Cancel a run",
        "description": "Cancel a run",
        "operationId": "cancel_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/decisions": {
      "post": {
        "tags": [
          "agent-tool"
        ],
        "summary": "Record a decision or assumption in the run's append-only log",
        "description": "Record a decision or assumption in the run's append-only log",
        "operationId": "log_decision",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/stream": {
      "get": {
        "tags": [
          "factory"
        ],
        "summary": "Server-sent events: live run events and status",
        "operationId": "stream_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswersInput": {
        "properties": {
          "answers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Answers"
          }
        },
        "type": "object",
        "required": [
          "answers"
        ],
        "title": "AnswersInput"
      },
      "ConfigView": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "product_lines": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Product Lines"
          },
          "stations": {
            "items": {
              "$ref": "#/components/schemas/StationView"
            },
            "type": "array",
            "title": "Stations"
          },
          "policies": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Policies"
          },
          "gates": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Gates"
          }
        },
        "type": "object",
        "required": [
          "name",
          "mode",
          "product_lines",
          "stations",
          "policies",
          "gates"
        ],
        "title": "ConfigView"
      },
      "CreateOrderInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 3,
            "title": "Title"
          },
          "requirements": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 10,
            "title": "Requirements"
          },
          "product_line": {
            "type": "string",
            "title": "Product Line",
            "default": "fastapi-service"
          }
        },
        "type": "object",
        "required": [
          "title",
          "requirements"
        ],
        "title": "CreateOrderInput"
      },
      "DecisionInput": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "station": {
            "type": "string",
            "title": "Station"
          },
          "decision": {
            "type": "string",
            "minLength": 3,
            "title": "Decision"
          },
          "rationale": {
            "type": "string",
            "title": "Rationale",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "station",
          "decision"
        ],
        "title": "DecisionInput"
      },
      "Event": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "title": "Ts"
          },
          "station": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Station"
          },
          "kind": {
            "$ref": "#/components/schemas/EventKind"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "id",
          "run_id",
          "ts",
          "kind",
          "message"
        ],
        "title": "Event"
      },
      "EventKind": {
        "type": "string",
        "enum": [
          "station_started",
          "station_finished",
          "decision",
          "log",
          "agent",
          "command",
          "status",
          "feedback"
        ],
        "title": "EventKind"
      },
      "Feedback": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "order_id",
          "run_id",
          "text",
          "created_at"
        ],
        "title": "Feedback"
      },
      "FeedbackInput": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 3,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "FeedbackInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthView": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "model_auth": {
            "type": "boolean",
            "title": "Model Auth"
          },
          "github": {
            "type": "boolean",
            "title": "Github"
          },
          "active_runs": {
            "type": "integer",
            "title": "Active Runs"
          }
        },
        "type": "object",
        "required": [
          "status",
          "mode",
          "model_auth",
          "github",
          "active_runs"
        ],
        "title": "HealthView"
      },
      "Order": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "requirements": {
            "type": "string",
            "title": "Requirements"
          },
          "product_line": {
            "type": "string",
            "title": "Product Line"
          },
          "product_slug": {
            "type": "string",
            "title": "Product Slug"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "latest_run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Run Id"
          },
          "latest_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "node_port": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Node Port"
          },
          "host_port": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Host Port"
          },
          "app_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "App Url"
          },
          "repo_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repo Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "requirements",
          "product_line",
          "product_slug",
          "created_at"
        ],
        "title": "Order"
      },
      "OrderDetail": {
        "properties": {
          "order": {
            "$ref": "#/components/schemas/Order"
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/Run"
            },
            "type": "array",
            "title": "Runs"
          },
          "feedback": {
            "items": {
              "$ref": "#/components/schemas/Feedback"
            },
            "type": "array",
            "title": "Feedback"
          }
        },
        "type": "object",
        "required": [
          "order",
          "runs",
          "feedback"
        ],
        "title": "OrderDetail"
      },
      "Run": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "iteration": {
            "type": "integer",
            "title": "Iteration"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "current_station": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Station"
          },
          "attempts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Attempts"
          },
          "loops": {
            "type": "integer",
            "title": "Loops",
            "default": 0
          },
          "change_request": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change Request"
          },
          "last_failure": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Failure"
          },
          "questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Questions"
          },
          "answers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Answers"
          },
          "resume_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resume At"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd",
            "default": 0.0
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "order_id",
          "iteration",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "Run"
      },
      "RunDetail": {
        "properties": {
          "run": {
            "$ref": "#/components/schemas/Run"
          },
          "order": {
            "$ref": "#/components/schemas/Order"
          },
          "stations": {
            "items": {
              "$ref": "#/components/schemas/StationView"
            },
            "type": "array",
            "title": "Stations"
          }
        },
        "type": "object",
